# --- Travelpayouts / Aviasales Data API (required) ---
# Free with affiliate registration: https://www.travelpayouts.com/developers/api
# TRAVELPAYOUTS_MARKER is your affiliate id; it is what makes booking
# deep-links attributable, and is separate from the API token.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# --- Aircraft enrichment (optional, Phase 3) ---
# AeroDataBox via RapidAPI: 600 free units/month.
AERODATABOX_RAPIDAPI_KEY=

# OpenSky Network: free, 4000 credits/day for registered users.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Storage ---
# Defaults to a local SQLite file. Point at Postgres for deployment, e.g.
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=

# --- Defaults ---
DEFAULT_CURRENCY=inr
DEFAULT_MARKET=IN

# How long a cached fare scan stays fresh before we re-fetch, in hours.
# Travelpayouts data itself refreshes on the order of hours, so going below
# ~6 mostly just burns quota without getting newer numbers.
FARE_CACHE_TTL_HOURS=6

HOST=127.0.0.1
PORT=8000
