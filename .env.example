# --- Travelpayouts / Aviasales Data API (required) ---
# Free. Sign up at https://travelpayouts.com ("Get Started"), then find the
# token at https://app.travelpayouts.com under Profile -> API token.
# It is issued automatically on registration; no approval step.
#
# TRAVELPAYOUTS_MARKER is your affiliate id, shown in the same dashboard. It is
# separate from the token and only affects whether booking deep-links are
# attributed to you — searches work without it.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# --- Ignav: live fares (exact airline, aircraft, price, booking links) ---
# 1,000 free requests, no card. Then $2 per 1,000; only HTTP 200s are billable.
# Key from https://ignav.com
IGNAV_API_KEY=
# Candidate dates resolved into exact itineraries per search. The only setting
# that costs money: one request each, so 10 is roughly $0.02 a search.
IGNAV_RESOLVE_LIMIT=10

# --- Aircraft enrichment (optional, Phase 3) ---
# AeroDataBox via RapidAPI: 600 free units/month.
AERODATABOX_RAPIDAPI_KEY=

# OpenSky Network: free, 4000 credits/day for registered users.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Price history ---
# A daily sweep of ~24 popular Indian routes, so history accumulates whether or
# not anyone searches. About one request per route per day. Skipped in demo mode.
ENABLE_BACKGROUND_SCANS=true
SWEEP_HOUR=3

# --- Storage ---
# Defaults to a local SQLite file. Point at Postgres for deployment, e.g.
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=

# --- Defaults ---
DEFAULT_CURRENCY=inr
DEFAULT_MARKET=IN

# How long a cached fare scan stays fresh before we re-fetch, in hours.
# Travelpayouts data itself refreshes on the order of hours, so going below
# ~6 mostly just burns quota without getting newer numbers.
FARE_CACHE_TTL_HOURS=6

HOST=127.0.0.1
PORT=8000
